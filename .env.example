# Optional local overrides; defaults work with the two-terminal development setup.
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=./data/dreamerie.sqlite
# Set SERVE_STATIC=1 for the built app on port 3001 (and change APP_ORIGIN to match).
# Hosted configuration requires NODE_ENV=production, HTTPS APP_ORIGIN,
# a persistent DATABASE_PATH, and the host's PORT/HOST settings.
