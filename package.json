{
  "name": "dreamerie",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env --watch --experimental-strip-types server/index.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit",
    "test": "node --experimental-strip-types --test tests/allocation.test.ts tests/week.test.ts tests/selection.test.ts tests/simulation.test.ts tests/board.test.ts tests/assignments.test.ts tests/progression.test.ts tests/personal.test.ts tests/roster.test.ts tests/server.test.ts",
    "test:server": "node --experimental-strip-types --test tests/server.test.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run typecheck && vite build && npm run build:server",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.4",
    "better-sqlite3": "12.11.1",
    "fastify": "5.12.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0"
  }
}
